# Copy this file to .env.local and fill in the values for local development.
# In production, set these in Vercel → Project → Settings → Environment Variables.

# Google Analytics 4 — Measurement ID (looks like G-XXXXXXXXXX).
# Find it in Google Analytics → Admin → Data streams → your web stream → Measurement ID.
# Safe to expose (it's public in the page anyway); the NEXT_PUBLIC_ prefix makes it available in the browser.
NEXT_PUBLIC_GA_ID=
