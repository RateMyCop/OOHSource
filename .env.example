# Copy this file to .env.local and fill in the values for local development.
# In production, set these in Vercel → Project → Settings → Environment Variables.

# Google Analytics 4 — Measurement ID (looks like G-XXXXXXXXXX).
# Find it in Google Analytics → Admin → Data streams → your web stream → Measurement ID.
# Safe to expose (it's public in the page anyway); the NEXT_PUBLIC_ prefix makes it available in the browser.
NEXT_PUBLIC_GA_ID=

# --- Airtable (optional) -------------------------------------------------------
# When AIRTABLE_TOKEN and AIRTABLE_BASE_ID are set, the directory reads listings
# from your Airtable base (revalidated every 60s). If unset, it uses the built-in
# seed data in lib/data.ts. These are server-only secrets (no NEXT_PUBLIC_ prefix).
#
# Personal Access Token — create at https://airtable.com/create/tokens
#   scopes: data.records:read  (+ optionally schema.bases:read)
#   access: the OOHsource base
AIRTABLE_TOKEN=
# Base ID — starts with "app...". Find it at https://airtable.com/api (pick the base).
AIRTABLE_BASE_ID=
# Table name — defaults to "Vendors" if omitted.
AIRTABLE_TABLE_NAME=Vendors
